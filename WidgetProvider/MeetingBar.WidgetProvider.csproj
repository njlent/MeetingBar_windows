<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net8.0-windows10.0.19041.0</TargetFramework><TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>MeetingBar.WidgetProvider</RootNamespace><AssemblyName>MeetingBar.WidgetProvider</AssemblyName><Version>0.1.2</Version><Platforms>x64</Platforms><PlatformTarget>x64</PlatformTarget><RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>false</UseWinUI><EnableMsixTooling>true</EnableMsixTooling><WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup><Content Include="Assets\**\*.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/><Content Include="Templates\**\*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/></ItemGroup>
  <ItemGroup><Compile Include="..\Localization\Localizer.cs" Link="Localization\Localizer.cs"/><EmbeddedResource Include="..\Localization\*.json" Exclude="..\Localization\en.json" LogicalName="MeetingBar.Localization.%(Filename).json"/></ItemGroup>
  <ItemGroup><PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.4"/></ItemGroup>
</Project>
